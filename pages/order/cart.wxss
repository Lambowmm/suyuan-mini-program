.cart-page {
  padding-bottom: 140rpx;
  background-color: #f7f9fc;
  min-height: 100vh;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 40rpx;
  text-align: center;
}

.empty-btn {
  background-color: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 40rpx;
}

.cart-tips {
  display: flex;
  align-items: center;
  background-color: #fffbe6;
  border: 1rpx solid #ffe58f;
  padding: 16rpx 24rpx;
  margin: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #d46b08;
}

.tips-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.tips-text {
  flex: 1;
}

.cart-list {
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cart-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  margin-right: 20rpx;
}

.card-delete {
  font-size: 24rpx;
  color: #ef4444;
  padding: 4rpx 10rpx;
}

.card-meta {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.card-unit-info {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.unit-tag {
  font-size: 22rpx;
  background-color: #f3f4f6;
  color: #374151;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.rule-tag {
  font-size: 20rpx;
  background-color: #f0fdf4;
  color: #16a34a;
  border: 1rpx solid #bbf7d0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #f3f4f6;
}

.card-price {
  display: flex;
  align-items: baseline;
}

.price-val {
  font-size: 32rpx;
  font-weight: 600;
  color: #ef4444;
}

.price-unit {
  font-size: 24rpx;
  color: #6b7280;
  margin-left: 4rpx;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f9fafb;
  font-size: 32rpx;
  color: #374151;
}

.stepper-btn.disabled {
  color: #d1d5db;
}

.stepper-val,
.stepper-input {
  min-width: 68rpx;
  width: 76rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
  background-color: #ffffff;
  border-left: 1rpx solid #e5e7eb;
  border-right: 1rpx solid #e5e7eb;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.card-subtotal {
  text-align: right;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
}

.subtotal-val {
  color: #ef4444;
  font-weight: 600;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-left {
  display: flex;
  flex-direction: column;
}

.bar-total-row {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 24rpx;
  color: #4b5563;
  margin-right: 8rpx;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
}

.bar-count-sub {
  font-size: 20rpx;
  color: #9ca3af;
}

.checkout-btn {
  background-color: #1677ff;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 44rpx;
  height: 76rpx;
  line-height: 76rpx;
}
