.catalog-page {
  min-height: 100vh;
  background: #f7fafc;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}

.auth-notice-card {
  margin-top: 100rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.notice-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff7e6;
  border: 4rpx solid #ffd591;
  margin: 0 auto 28rpx;
}

.notice-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #2d3748;
}

.notice-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

.notice-btn {
  margin-top: 40rpx;
  background: #0e7c7b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.catalog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.hospital-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #e8f5f4;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.badge-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #0e5f60;
}

.header-link {
  font-size: 26rpx;
  font-weight: bold;
  color: #0e7c7b;
}

.search-box {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 76rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.search-btn {
  background: #0e7c7b;
  color: #fff;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  margin: 0;
}

.catalog-body {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.category-sidebar {
  width: 140rpx;
  flex-shrink: 0;
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
  position: sticky;
  top: 20rpx;
  z-index: 20;
}

.side-tab-item {
  padding: 24rpx 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #4a5568;
  background: #ffffff;
  border-bottom: 1rpx solid #f7fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  word-break: break-all;
  transition: all 0.2s ease;
}

.side-tab-item:last-child {
  border-bottom: none;
}

.side-tab-item.active {
  background: #e8f5f4;
  color: #0e7c7b;
  font-weight: 700;
  border-left: 6rpx solid #0e7c7b;
}

.material-list {
  flex: 1;
  min-width: 0;
}

.material-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.03);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.head-left {
  flex: 1;
  margin-right: 16rpx;
}

.mat-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
  line-height: 1.3;
}

.mat-code {
  font-size: 22rpx;
  color: #a0aec0;
  margin-top: 4rpx;
}

.mat-category-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: #e6f4f4;
  color: #0e7c7b;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
}

.card-meta {
  font-size: 24rpx;
  color: #4a5568;
  margin-bottom: 14rpx;
  line-height: 1.6;
}

.meta-row {
  display: flex;
  margin-bottom: 4rpx;
}

.meta-label {
  color: #718096;
  width: 140rpx;
  flex-shrink: 0;
}

.meta-val {
  flex: 1;
}

.stock-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.stock-tag.in-stock {
  background: #e6fffa;
  color: #047857;
}

.stock-tag.low-stock {
  background: #fff1f0;
  color: #cf1322;
}

.quota-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 10rpx 0 14rpx 0;
  padding: 6rpx 14rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 8rpx;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 500;
}

.quota-badge.quota-exceeded {
  background: #fef2f2;
  border-color: #fecaca;
  color: #dc2626;
}

.quota-icon {
  font-size: 22rpx;
}

.unit-selector {
  margin: 14rpx 0;
  padding: 12rpx 0;
  border-top: 1rpx solid #edf2f7;
  border-bottom: 1rpx solid #edf2f7;
}

.unit-title {
  font-size: 22rpx;
  color: #718096;
  margin-bottom: 10rpx;
}

.unit-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.unit-tag {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #f7fafc;
  border: 1rpx solid #e2e8f0;
  color: #4a5568;
}

.unit-tag.active {
  background: #e8f5f4;
  border-color: #0e7c7b;
  color: #0e7c7b;
  font-weight: 700;
}

.price-rule-tip {
  margin-bottom: 12rpx;
}

.rule-badge {
  font-size: 20rpx;
  color: #8c5b00;
  background: #fffbe6;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #edf2f7;
}

.price-display {
  display: flex !important;
  align-items: baseline !important;
  white-space: nowrap !important;
  flex-shrink: 0;
}

.currency {
  font-size: 24rpx;
  color: #e53e3e;
  font-weight: 700;
  line-height: 1;
}

.price-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #e53e3e;
  line-height: 1;
  margin: 0 2rpx 0 4rpx;
}

.price-unit {
  font-size: 20rpx;
  color: #8c9ba5;
  white-space: nowrap;
  line-height: 1;
}

.foot-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.btn-detail {
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  background: #edf2f7;
  color: #4a5568;
  border-radius: 8rpx;
  white-space: nowrap;
  line-height: normal;
}

.qty-stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  overflow: hidden;
  background: #ffffff;
  height: 48rpx;
}

.stepper-btn {
  width: 40rpx;
  height: 48rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #374151;
  background: #f3f4f6;
}

.stepper-btn.disabled {
  color: #d1d5db;
  background: #f9fafb;
}

.stepper-input {
  width: 52rpx;
  height: 48rpx;
  line-height: 48rpx;
  min-height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #111827;
  background: #ffffff;
  border-left: 1rpx solid #e5e7eb;
  border-right: 1rpx solid #e5e7eb;
  padding: 0;
}

.btn-cart {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #0e7c7b;
  color: #ffffff;
  border-radius: 8rpx;
  white-space: nowrap;
  line-height: normal;
}

.btn-cart.disabled {
  background: #9ca3af;
  color: #ffffff;
}

.empty-tip {
  text-align: center;
  color: #a0aec0;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.floating-cart {
  position: fixed;
  bottom: 30rpx;
  left: 24rpx;
  right: 24rpx;
  height: 100rpx;
  background: #1a202c;
  color: #fff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.25);
  z-index: 100;
}

.cart-left {
  display: flex;
  align-items: center;
}

.cart-badge-wrap {
  position: relative;
  margin-right: 16rpx;
}

.cart-icon {
  font-size: 44rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  background: #e53e3e;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  height: 32rpx;
  min-width: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 6rpx;
}

.cart-hint {
  font-size: 26rpx;
  color: #cbd5e0;
}

.cart-go {
  font-size: 30rpx;
  font-weight: 800;
  color: #4fd1c5;
}
