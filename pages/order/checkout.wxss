.checkout-page {
  padding: 20rpx 20rpx 140rpx 20rpx;
  background-color: #f7f9fc;
  min-height: 100vh;
}

.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.switch-addr {
  font-size: 24rpx;
  color: #1677ff;
}

.addr-person {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.addr-phone {
  font-size: 26rpx;
  color: #4b5563;
}

.default-badge {
  font-size: 20rpx;
  background-color: #e6f4ff;
  color: #1677ff;
  border: 1rpx solid #91caff;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.addr-detail {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.4;
}

.address-empty {
  font-size: 26rpx;
  color: #ef4444;
  line-height: 1.5;
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.item-row:last-child {
  border-bottom: none;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.item-spec {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.item-price {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.item-total {
  text-align: right;
  margin-left: 20rpx;
}

.line-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #ef4444;
}

.remarks-input {
  width: 100%;
  height: 140rpx;
  background-color: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.total-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e5e7eb;
  align-items: baseline;
}

.font-bold {
  font-weight: 600;
  color: #1f2937;
  font-size: 28rpx;
}

.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-left {
  display: flex;
  align-items: baseline;
}

.bar-label {
  font-size: 24rpx;
  color: #4b5563;
  margin-right: 8rpx;
}

.bar-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
}

.submit-btn {
  background-color: #1677ff;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 44rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.submit-btn[disabled] {
  background-color: #93c5fd;
  color: #ffffff;
}

.btn-submitting {
  background-color: #60a5fa !important;
  opacity: 0.9;
}

.btn-submitted, .submit-btn[disabled].btn-submitted {
  background-color: #10b981 !important;
  color: #ffffff !important;
  opacity: 1 !important;
}

/* 顶部订单成功提示横幅 */
.order-success-banner {
  background: linear-gradient(135deg, #059669, #10b981);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.25);
}

.banner-success-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.banner-success-text {
  flex: 1;
}

.banner-success-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.banner-success-sub {
  font-size: 22rpx;
  opacity: 0.9;
}

.banner-success-btn {
  background-color: #ffffff;
  color: #059669;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 28rpx;
  padding: 6rpx 20rpx;
  line-height: 1.6;
  margin-left: 12rpx;
  border: none;
}

/* ============================================== */
/* 自定义弹窗蒙层与容器 */
/* ============================================== */
.custom-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(15, 23, 42, 0.65);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
}

.custom-modal-box {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  animation: modalScaleIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalScaleIn {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 弹窗头部 */
.cmodal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 20rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
  background: #ffffff;
}

.cmodal-title-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cmodal-badge-icon {
  font-size: 32rpx;
}

.cmodal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.cmodal-close {
  font-size: 34rpx;
  color: #94a3b8;
  padding: 6rpx 12rpx;
  font-weight: 400;
  line-height: 1;
}

/* 弹窗内容滚动区 */
.cmodal-scroll-body {
  max-height: 62vh;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  background-color: #f8fafc;
}

/* 板块卡片 */
.cmodal-card-block {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.cmodal-block-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
  border-bottom: 1rpx dashed #f1f5f9;
  padding-bottom: 10rpx;
}

.cmodal-icon-small {
  font-size: 26rpx;
}

.cmodal-label-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.cmodal-item-count {
  font-size: 22rpx;
  color: #64748b;
  margin-left: 6rpx;
}

/* 地址详情 */
.cmodal-addr-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cmodal-person-line {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.cmodal-person-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.cmodal-person-phone {
  font-size: 24rpx;
  color: #475569;
}

.cmodal-addr-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
  word-break: break-all;
}

/* 订购商品列表 */
.cmodal-materials-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.cmodal-material-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f8fafc;
}

.cmodal-material-item:last-child {
  border-bottom: none;
}

.cmodal-mat-info {
  flex: 1;
  margin-right: 16rpx;
}

.cmodal-mat-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
}

.cmodal-mat-spec {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-top: 2rpx;
}

.cmodal-mat-price {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

/* 汇总板块 */
.cmodal-summary-block {
  background: #ffffff;
}

.cmodal-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.cmodal-row-key {
  font-size: 26rpx;
  color: #64748b;
}

.cmodal-row-key.highlight {
  color: #0f172a;
  font-weight: 700;
}

.cmodal-settle-tag {
  background: #e0f2fe;
  color: #0284c7;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.cmodal-total-line {
  border-top: 1rpx dashed #e2e8f0;
  padding-top: 14rpx;
  margin-top: 10rpx;
  margin-bottom: 0;
}

.cmodal-price-wrap {
  display: flex;
  align-items: baseline;
}

.cmodal-currency {
  font-size: 26rpx;
  font-weight: 800;
  color: #dc2626;
  margin-right: 2rpx;
}

.cmodal-amount-number {
  font-size: 38rpx;
  font-weight: 800;
  color: #dc2626;
}

/* 提示条 */
.cmodal-guide-tip {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  background: #fffbeb;
  border-radius: 14rpx;
  border: 1rpx solid #fed7aa;
  margin-bottom: 8rpx;
}

.cmodal-tip-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.cmodal-tip-text {
  font-size: 22rpx;
  color: #b45309;
  line-height: 1.45;
}

/* 弹窗底部操作按钮 */
.cmodal-btn-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-top: 1rpx solid #f1f5f9;
}

.cmodal-action-btn {
  flex: 1;
  height: 82rpx;
  line-height: 82rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
  text-align: center;
  margin: 0;
  padding: 0;
  border: none;
}

.cmodal-btn-cancel {
  background: #f1f5f9;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}

.cmodal-btn-cancel:active {
  background: #e2e8f0;
}

.cmodal-btn-confirm {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(22, 119, 255, 0.35);
}

.cmodal-btn-confirm:active {
  background: #0958d9;
}

/* ============================================== */
/* 提交成功弹窗样式 */
/* ============================================== */
.success-modal-box {
  padding: 0;
}

.cmodal-success-banner {
  text-align: center;
  padding: 44rpx 32rpx 16rpx 32rpx;
  background: linear-gradient(180deg, #ecfdf5 0%, #ffffff 100%);
}

.cmodal-success-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50%;
  background: #10b981;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 800;
  margin: 0 auto 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.32);
}

.cmodal-success-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.cmodal-success-sub {
  font-size: 24rpx;
  color: #64748b;
}

.cmodal-success-details {
  background: #f8fafc;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  margin: 16rpx 28rpx 24rpx 28rpx;
  padding: 20rpx 24rpx;
}

.cmodal-success-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.cmodal-success-row:last-child {
  border-bottom: none;
}

.cmodal-s-label {
  font-size: 24rpx;
  color: #64748b;
}

.cmodal-s-val-group {
  display: flex;
  align-items: center;
}

.cmodal-s-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
}

.s-order-no {
  font-family: monospace;
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 700;
}

.cmodal-copy-btn {
  font-size: 20rpx;
  color: #1677ff;
  background: #e6f4ff;
  border: 1rpx solid #91caff;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
  font-weight: 600;
}

.cmodal-copy-btn:active {
  background: #bae0ff;
}

.s-price {
  color: #dc2626;
  font-size: 30rpx;
  font-weight: 800;
}

.s-status-pill {
  background: #fef3c7;
  color: #b45309;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.cmodal-btn-secondary {
  background: #f1f5f9;
  color: #334155;
  border: 1rpx solid #cbd5e1;
}

.cmodal-btn-secondary:active {
  background: #e2e8f0;
}

.cmodal-btn-primary {
  background: #1677ff;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(22, 119, 255, 0.35);
}

.cmodal-btn-primary:active {
  background: #0958d9;
}

