.mine-page {
  padding-bottom: 60rpx;
  background-color: #f7f9fc;
  min-height: 100vh;
}

.user-card {
  background: linear-gradient(135deg, #0e7c7b 0%, #095958 100%);
  padding: 44rpx 32rpx 36rpx 32rpx;
  color: #ffffff;
  border-bottom-left-radius: 28rpx;
  border-bottom-right-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 124, 123, 0.18);
  position: relative;
  overflow: hidden;
}

.user-card::after {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

.user-header {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 104rpx !important;
  min-width: 104rpx !important;
  max-width: 104rpx !important;
  height: 104rpx !important;
  min-height: 104rpx !important;
  max-height: 104rpx !important;
  border-radius: 50% !important;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 24rpx 0 0 !important;
  padding: 0 !important;
  position: relative;
  overflow: hidden !important;
  flex-shrink: 0;
  box-sizing: border-box !important;
}

.avatar-btn-picker {
  margin: 0 24rpx 0 0 !important;
  padding: 0 !important;
  width: 104rpx !important;
  min-width: 104rpx !important;
  max-width: 104rpx !important;
  height: 104rpx !important;
  min-height: 104rpx !important;
  max-height: 104rpx !important;
  border-radius: 50% !important;
  border: none !important;
  background: transparent !important;
  line-height: normal;
  outline: none;
  overflow: hidden !important;
}

.avatar-btn-picker::after {
  border: none !important;
}

.avatar-img {
  width: 100% !important;
  height: 100% !important;
  border-radius: 50% !important;
  display: block;
}

.avatar-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 28rpx;
  line-height: 28rpx;
  font-size: 16rpx;
  background-color: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  text-align: center;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
}

.user-phone {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.phone-bound {
  color: #a7f3d0;
}

.phone-unbound {
  opacity: 0.8;
}

.user-hospital {
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-top: 8rpx;
}

.header-action {
  margin-left: 20rpx;
}

.login-btn {
  background-color: #ffffff;
  color: #0e7c7b;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  padding: 0 34rpx;
  height: 64rpx;
  line-height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.1);
  border: none !important;
  margin: 0;
  letter-spacing: 1rpx;
}

.login-btn:active {
  background-color: #f1f5f9;
  transform: scale(0.98);
}

.status-pill {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background-color: rgba(255, 255, 255, 0.25);
  font-weight: 500;
}

.status-APPROVED {
  background-color: #10b981;
  color: #ffffff;
}

.status-PENDING {
  background-color: #f59e0b;
  color: #ffffff;
}

.status-REJECTED {
  background-color: #ef4444;
  color: #ffffff;
}

/* 微信手机号官方一键绑定按钮行 */
.bind-phone-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.wx-phone-btn {
  background-color: #ffffff;
  color: #0e7c7b;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.phone-btn-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

/* 审核状态实时通知横幅 */
.audit-notice-bar {
  margin: 20rpx 20rpx 0 20rpx;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-start;
}

.audit-notice-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.audit-notice-text {
  flex: 1;
}

.audit-notice-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.audit-notice-sub {
  font-size: 22rpx;
  line-height: 1.4;
}

.audit-notice-pending {
  background-color: #fffbeb;
  border: 1rpx solid #fde68a;
  color: #92400e;
}

.audit-notice-approved {
  background-color: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  color: #065f46;
}

.notice-dismiss-btn {
  font-size: 28rpx;
  color: #059669;
  padding: 4rpx 14rpx;
  margin-left: 12rpx;
  opacity: 0.75;
  line-height: 1;
}

.notice-dismiss-btn:active {
  opacity: 1;
}

.audit-notice-rejected {
  background-color: #fef2f2;
  border: 1rpx solid #fecaca;
  color: #991b1b;
}

/* 准入资质状态卡片 */
.access-card {
  margin: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.access-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.access-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.access-title-right {
  display: flex;
  align-items: center;
}

.card-close-btn {
  font-size: 22rpx;
  color: #4b5563;
  background-color: #f3f4f6;
  border: 1rpx solid #e5e7eb;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 14rpx;
}

.card-close-btn:active {
  background-color: #e5e7eb;
}

.access-status-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.badge-APPROVED {
  background-color: #dcfce7;
  color: #16a34a;
}

.badge-PENDING {
  background-color: #fef3c7;
  color: #d97706;
}

.badge-REJECTED, .badge-DISABLED {
  background-color: #fee2e2;
  color: #dc2626;
}

.access-more-hint {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e5e7eb;
  font-size: 22rpx;
  color: #0e7c7b;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hint-arrow {
  font-weight: 600;
}

.access-body {
  padding-top: 16rpx;
}

.access-item {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.label {
  color: #6b7280;
}

.val {
  color: #1f2937;
  font-weight: 500;
}

.font-highlight {
  color: #0e7c7b;
  font-weight: 600;
}

.access-tips {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 12rpx;
  line-height: 1.4;
}

.pending-notice, .reject-notice, .unapplied-notice {
  font-size: 24rpx;
  line-height: 1.5;
  color: #6b7280;
  margin-bottom: 16rpx;
  white-space: pre-line;
}

.notice-title {
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 4rpx;
}

.apply-btn {
  background-color: #0e7c7b;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 30rpx;
  height: 68rpx;
  line-height: 68rpx;
}

.pending-btn {
  background-color: #f3f4f6 !important;
  color: #9ca3af !important;
  font-size: 26rpx;
  border-radius: 30rpx;
  height: 68rpx;
  line-height: 68rpx;
  border: 1rpx solid #e5e7eb;
}

.menu-group {
  margin: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.menu-title {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.menu-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid #c7c7cc;
  border-right: 4rpx solid #c7c7cc;
  transform: rotate(45deg);
  margin-right: 6rpx;
  flex-shrink: 0;
}

.logout-wrap {
  margin: 40rpx 20rpx;
}

.logout-btn {
  background-color: #ffffff;
  color: #ef4444;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: 1rpx solid #ef4444;
  height: 80rpx;
  line-height: 78rpx;
}
