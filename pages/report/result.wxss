.result-page {
  background: #f7fafc;
}


.summary-card {
  padding: 34rpx 32rpx;
  color: #ffffff;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #0b6f70, #15998f);
  box-shadow: 0 16rpx 32rpx rgba(14, 124, 123, 0.18);
}

.summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-kicker {
  font-size: 23rpx;
  opacity: 0.82;
}

.summary-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.summary-count {
  min-width: 116rpx;
  padding: 12rpx 18rpx;
  text-align: center;
  font-size: 25rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.summary-range {
  margin-top: 28rpx;
  font-size: 27rpx;
  opacity: 0.9;
}

.search-card {
  display: flex;
  margin-top: 24rpx;
  padding: 16rpx;
  border: 1rpx solid #e2eaf0;
  border-radius: 16rpx;
  background: #ffffff;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  color: #17212b;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #f5f8fa;
}

.search-placeholder {
  color: #9aa6b2;
}

.result-page button.search-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  min-width: 0;
  flex: 0 0 92rpx;
  height: 76rpx;
  margin-left: 12rpx;
  padding: 0;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #0e7c7b;
}

.result-page button.search-button::after {
  border: 0;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 0 6rpx;
}

.filter-text {
  max-width: 510rpx;
  color: #687788;
  font-size: 25rpx;
}

.result-page button.filter-clear {
  flex: none;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  line-height: 2;
  color: #0e7c7b;
  font-size: 25rpx;
}

.loading-line {
  padding: 80rpx 0;
  text-align: center;
  color: #7a8794;
  font-size: 27rpx;
}

.report-list {
  margin-top: 24rpx;
}

.report-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 152rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e5edf2;
  border-radius: 16rpx;
  background: #ffffff;
}

.report-extra { margin-top: 7rpx; color: #687788; font-size: 23rpx; overflow-wrap: anywhere; }
.risk-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 9rpx; }
.risk-badge { padding: 4rpx 10rpx; border-radius: 8rpx; font-size: 21rpx; font-weight: 700; }
.risk-badge.danger { background: #fce8e8; color: #b42318; }
.risk-badge.abnormal { background: #fff2dc; color: #955c00; }
.lis-report-item { flex-wrap: wrap; align-items: flex-start; }
.lis-report-item .report-row { flex-basis: 100%; }
.lis-report-item .report-main { width: 100%; align-items: flex-start; }
.lis-report-item .report-action { margin-top: 18rpx; margin-left: auto; }
.lis-report-item .report-name,
.lis-report-item .report-meta { max-width: none; }
.lis-report-item .report-date { white-space: normal; }

.report-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.report-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.report-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  color: #0e7c7b;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 18rpx;
  background: #e8f5f4;
}

.report-icon.immune {
  color: #8a5a00;
  background: #fff5d8;
}

.report-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.report-name {
  max-width: 300rpx;
  color: #17212b;
  font-size: 31rpx;
  font-weight: 700;
}

.report-meta {
  max-width: 300rpx;
  margin-top: 10rpx;
  color: #687788;
  font-size: 25rpx;
}

.report-date {
  margin-top: 8rpx;
  color: #98a4af;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.report-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 214rpx;
  gap: 18rpx;
  margin-left: 18rpx;
}

.view-button,
.download-button,
.previewing {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  min-width: 0;
  height: 60rpx;
  padding: 0;
  text-align: center;
  color: #55a8f7;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 60rpx;
  box-sizing: border-box;
  border: 2rpx solid #55a8f7;
  border-radius: 999rpx;
  background: #ffffff;
}

.view-button,
.download-button {
  margin: 0;
}

.download-button {
  color: #55a8f7;
  border-color: #55a8f7;
}

.view-button::after,
.download-button::after {
  border: 0;
}

.previewing {
  color: #7a8794;
  border-color: #d8e2e9;
}

.empty-card {
  margin-top: 28rpx;
  padding: 80rpx 36rpx;
  text-align: center;
  border: 1rpx solid #e3ebf0;
  border-radius: 16rpx;
  background: #ffffff;
}

.empty-title {
  color: #17212b;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-text {
  margin-top: 16rpx;
  color: #7a8794;
  font-size: 26rpx;
  line-height: 1.7;
}

.summary-range-row { display: flex; flex-wrap: nowrap; align-items: center; gap: 12rpx; width: 100%; min-width: 0; margin-top: 24rpx; }
.range-text { display: block; flex: 1 1 0; min-width: 0; font-size: 23rpx; line-height: 1.5; white-space: nowrap; }
.result-page button.edit-range { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; width: auto; min-width: 0; height: 52rpx; padding: 0 14rpx; margin: 0; font-size: 23rpx; line-height: 1; white-space: nowrap; color: #fff; background: rgba(255,255,255,.18); border-radius: 10rpx; }
.filter-toolbar { display: flex; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 8rpx; width: 100%; min-width: 0; margin-top: 20rpx; }
.risk-filters, .display-filters { display: flex; flex: 0 0 auto; align-items: center; gap: 8rpx; min-width: 0; }
.display-filters { margin-left: auto; }
.display-filters picker { display: block; flex: none; width: auto; min-width: 0; }
.result-page button.filter-chip, .control-value { display: flex; align-items: center; justify-content: center; flex: none; width: auto; min-width: 0; height: 64rpx; padding: 0 14rpx; margin: 0; line-height: 1; color: #465466; font-size: 24rpx; white-space: nowrap; border-radius: 12rpx; background: #fff; }
.result-page button.filter-chip.selected { color: #fff; background: #0e7c7b; }
.result-page button.filter-chip::after, .result-page button.edit-range::after, .result-page button.page-button::after { border: 0; }
.pagination { display: flex; flex-wrap: nowrap; align-items: center; justify-content: center; gap: 6rpx; width: 100%; min-width: 0; margin-top: 30rpx; }
.result-page button.page-button { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 96rpx; min-width: 0; height: 64rpx; margin: 0; padding: 0; font-size: 24rpx; line-height: 1; white-space: nowrap; border-radius: 10rpx; background: #fff; color: #0e7c7b; }
.result-page button.page-number { width: 64rpx; }
.result-page button.page-number.active { background: #0e7c7b; color: #fff; }
.result-page button.page-button[disabled] { opacity: .45; }
.page-gap, .page-status { color: #7a8794; font-size: 24rpx; }
.page-gap { flex: none; width: 24rpx; text-align: center; }
.page-status { text-align: center; padding: 16rpx 0 30rpx; }
@media (max-width: 340px) {
  .filter-toolbar { gap: 6rpx; }
  .risk-filters, .display-filters { gap: 6rpx; }
  .result-page button.filter-chip, .control-value { padding: 0 10rpx; font-size: 22rpx; }
  .range-text, .result-page button.edit-range { font-size: 21rpx; }
  .pagination { gap: 4rpx; }
  .result-page button.page-button { width: 92rpx; font-size: 22rpx; }
  .result-page button.page-number { width: 64rpx; }
}
page { --td-brand-color: #0e7c7b; --td-brand-color-light: #eef8f7; }
