.result-page {
  background: #f7fafc;
}

.summary-card {
  padding: 34rpx 32rpx;
  color: #ffffff;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #0b6f70, #15998f);
  box-shadow: 0 16rpx 32rpx rgba(14, 124, 123, 0.18);
}

.summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-kicker {
  font-size: 23rpx;
  opacity: 0.82;
}

.summary-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.summary-count {
  min-width: 116rpx;
  padding: 12rpx 18rpx;
  text-align: center;
  font-size: 25rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.summary-range {
  margin-top: 28rpx;
  font-size: 27rpx;
  opacity: 0.9;
}

.search-card {
  display: flex;
  margin-top: 24rpx;
  padding: 16rpx;
  border: 1rpx solid #e2eaf0;
  border-radius: 16rpx;
  background: #ffffff;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  color: #17212b;
  font-size: 28rpx;
  border-radius: 12rpx;
  background: #f5f8fa;
}

.search-placeholder {
  color: #9aa6b2;
}

.search-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  min-width: 0;
  flex: 0 0 92rpx;
  height: 76rpx;
  margin-left: 12rpx;
  padding: 0;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 76rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #0e7c7b;
}

.search-button::after {
  border: 0;
}

.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 0 6rpx;
}

.filter-text {
  max-width: 510rpx;
  color: #687788;
  font-size: 25rpx;
}

.filter-clear {
  color: #0e7c7b;
  font-size: 25rpx;
}

.loading-line {
  padding: 80rpx 0;
  text-align: center;
  color: #7a8794;
  font-size: 27rpx;
}

.report-list {
  margin-top: 24rpx;
}

.report-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 152rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e5edf2;
  border-radius: 16rpx;
  background: #ffffff;
}

.report-row {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.report-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.report-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  color: #0e7c7b;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 18rpx;
  background: #e8f5f4;
}

.report-icon.immune {
  color: #8a5a00;
  background: #fff5d8;
}

.report-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.report-name {
  max-width: 300rpx;
  color: #17212b;
  font-size: 31rpx;
  font-weight: 700;
}

.report-meta {
  max-width: 300rpx;
  margin-top: 10rpx;
  color: #687788;
  font-size: 25rpx;
}

.report-date {
  margin-top: 8rpx;
  color: #98a4af;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.report-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 214rpx;
  gap: 18rpx;
  margin-left: 18rpx;
}

.view-button,
.download-button,
.previewing {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 98rpx;
  min-width: 0;
  height: 60rpx;
  padding: 0;
  text-align: center;
  color: #55a8f7;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 60rpx;
  box-sizing: border-box;
  border: 2rpx solid #55a8f7;
  border-radius: 999rpx;
  background: #ffffff;
}

.view-button,
.download-button {
  margin: 0;
}

.download-button {
  color: #55a8f7;
  border-color: #55a8f7;
}

.view-button::after,
.download-button::after {
  border: 0;
}

.previewing {
  color: #7a8794;
  border-color: #d8e2e9;
}

.empty-card {
  margin-top: 28rpx;
  padding: 80rpx 36rpx;
  text-align: center;
  border: 1rpx solid #e3ebf0;
  border-radius: 16rpx;
  background: #ffffff;
}

.empty-title {
  color: #17212b;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-text {
  margin-top: 16rpx;
  color: #7a8794;
  font-size: 26rpx;
  line-height: 1.7;
}
